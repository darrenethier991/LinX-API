{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "linx-api",
  // FIXED: was "workers/api/index.js" (does not exist) — the real entry is workers/api.js
  "main": "workers/api.js",
  "compatibility_date": "2025-01-01",
  "workers_dev": false,

  "account_id": "d4a4ddeeb9c43fe4b50a48143ec0c4e3",

  "routes": [
    { "pattern": "api.linxservices.ca/*", "zone_name": "linxservices.ca" }
  ],

  "kv_namespaces": [
    {
      "binding": "LINX_KV",
      "id": "f34be72d11804233afda93230956946f",
      "preview_id": "f34be72d11804233afda93230956946f"
    }
  ],

  "ai": { "binding": "AI" },

  "triggers": {
    "crons": ["0 * * * *"]
  },

  "vars": {
    "ADMIN_USERNAME": "admin"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "linx-db",
      "database_id": "8145e238-53cb-4a95-b9d3-bc71de967678",
      "migrations_dir": "./workers/migrations"
    }
  ],

  "observability": {
    "enabled": true
  },

  // FIXED: added env.sms / env.ai so `wrangler deploy --env sms` works
  "env": {
    "sms": {
      "name": "linx-sms",
      "main": "workers/sms.js",
      "workers_dev": false,
      "routes": [
        { "pattern": "sms.linxservices.ca/*", "zone_name": "linxservices.ca" }
      ],
      "kv_namespaces": [
        {
          "binding": "LINX_KV",
          "id": "f34be72d11804233afda93230956946f",
          "preview_id": "f34be72d11804233afda93230956946f"
        }
      ]
    },
    "ai": {
      "name": "linx-ai-gateway",
      "main": "workers/ai-gateway.js",
      "workers_dev": false,
      "routes": [
        { "pattern": "ai.linxservices.ca/*", "zone_name": "linxservices.ca" }
      ],
      "kv_namespaces": [
        {
          "binding": "LINX_KV",
          "id": "f34be72d11804233afda93230956946f",
          "preview_id": "f34be72d11804233afda93230956946f"
        }
      ],
      "ai": { "binding": "AI" }
    }
  }
}
