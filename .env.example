# LinX — Environment Variables
# Copy to .env and fill in real values.
# NEVER commit .env — it is in .gitignore.
#
# Sections:
#   A. Supabase
#   B. Cloudflare Workers / KV
#   C. LinX Echo (AI Gateway)
#   D. Twilio
#   E. Service-to-service
#   F. Billing
#   G. Stripe
#   H. Vite (browser-safe, VITE_ prefix only)

# ── A. Supabase ──────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ⚠️ SERVER ONLY — never expose to browser or commit
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── B. Cloudflare Workers / KV ───────────────────────────────────────────────
CF_ACCOUNT_ID=your-cloudflare-account-id
CF_API_TOKEN=your-cloudflare-api-token

# KV Namespace IDs (from: wrangler kv namespace create LINX_KV)
KV_NAMESPACE_ID=replace-with-production-namespace-id
KV_PREVIEW_ID=replace-with-preview-namespace-id

# ── C. LinX Echo (AI Gateway Worker) ─────────────────────────────────────────
# The deployed URL of workers/ai-gateway.js
AI_GATEWAY_URL=https://ai.linxservices.ca

# ⚠️ SERVER ONLY — shared secret for ai-gateway.js proxy to FastAPI Echo
LINX_ECHO_URL=https://echo.your-backend.workers.dev
LINX_ECHO_SECRET=generate-a-random-secret-here

# ── D. Twilio ─────────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM_NUMBER=+1xxxxxxxxxx

# ── E. Service-to-service ─────────────────────────────────────────────────────
# Shared bearer token used between api.js, sms.js, ai-gateway.js
# Generate: openssl rand -hex 32
API_INTERNAL_TOKEN=replace-with-32-byte-hex-secret

# Deployed worker URLs (used by sms.js and workflows to call api.js)
API_URL=https://api.linxservices.ca
SMS_WORKER_URL=https://sms.linxservices.ca

# ── F. Billing ────────────────────────────────────────────────────────────────
COST_PER_MESSAGE_CENTS=1
GLOBAL_DAILY_CAP=50000

# ── G. Stripe (server-only unless noted) ─────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Safe for browser bundle (VITE_ prefix)
STRIPE_PUBLISHABLE_KEY=pk_live_...

# ── H. Vite (browser-safe) ────────────────────────────────────────────────────
# These are bundled into the client — only put non-secret values here
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
VITE_API_URL=https://api.linxservices.ca
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_...
