{
  "name": "linx-site",
  "version": "0.1.0",
  "private": true,
  "description": "LinX SaaS — Cloudflare Workers + Supabase + Twilio",
  "scripts": {
    "dev":        "wrangler dev workers/api.js",
    "dev:sms":    "wrangler dev workers/sms.js",
